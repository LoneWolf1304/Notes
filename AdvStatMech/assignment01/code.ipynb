   "source": [
    "N = 100\n",
    "k = 0:N-1\n",
    "x = @. cos(pi*(2*k+1)/N)\n",
    "y = @. sin(pi*(2*k+1)/N)\n",
    "scatter!(x,y)\n",
    "hline!([0])"
